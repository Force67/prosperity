#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) readonly buffer In { uint v[]; } src;
layout(set = 0, binding = 1) buffer Out { uint v[]; } dst;
layout(set = 0, binding = 2) uniform U { uint mul; } u;
void main() {
  uint i = gl_GlobalInvocationID.x;
  dst.v[i] = src.v[i] * u.mul + gl_NumWorkGroups.x;
  uint lanes = subgroupAdd(1u);
  if (i == 0u) {
    dst.v[128] = uint(src.v.length());
    dst.v[129] = lanes;
  }
}
